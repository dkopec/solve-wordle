    private async Task FindWordsFromGuesses()
    {
        if (solver == null) return;

        isFiltering = true;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            // Extract correct positions (green letters)
            var correctPositions = new char[5];
            for (int i = 0; i < 5; i++)
            {
                correctPositions[i] = '_';
            }

            // Extract wrong positions and excluded letters from locked guesses only
            var wrongPositionsList = new List<string>();
            var excludedLetters = new HashSet<char>();

            foreach (var guess in guesses.Where(g => g.IsLocked && !string.IsNullOrEmpty(g.Word)))
            {
                for (int i = 0; i < 5 && i < guess.Word.Length; i++)
                {
                    var letter = char.ToLower(guess.Word[i]);
                    var state = guess.States[i];

                    if (state == LetterState.Green)
                    {
                        correctPositions[i] = letter;
                    }
                    else if (state == LetterState.Yellow)
                    {
                        wrongPositionsList.Add($"{letter}:{i + 1}");
                    }
                    else if (state == LetterState.Gray)
                    {
                        // Only exclude if it's not marked as green or yellow elsewhere
                        bool isInWordElsewhere = false;
                        for (int j = 0; j < 5 && j < guess.Word.Length; j++)
                        {
                            if (char.ToLower(guess.Word[j]) == letter && 
                                (guess.States[j] == LetterState.Green || guess.States[j] == LetterState.Yellow))
                            {
                                isInWordElsewhere = true;
                                break;
                            }
                        }
                        if (!isInWordElsewhere)
                        {
                            excludedLetters.Add(letter);
                        }
                    }
                }
            }

            var correctPositionsStr = new string(correctPositions);
            var wrongPositionsStr = string.Join(", ", wrongPositionsList);
            var excludedLettersStr = string.Join("", excludedLetters);

            // Get results
            possibleWords = solver.GetRankedSuggestions(
                correctPositionsStr,
                wrongPositionsStr,
                excludedLettersStr,
                false // Don't exclude past answers by default in new UI
            );
        }
        finally
        {
            isFiltering = false;
        }
    }

