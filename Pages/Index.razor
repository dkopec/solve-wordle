    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Find the current active guess (unlocked with a word)
        var currentGuess = guesses.FirstOrDefault(g => !g.IsLocked && !string.IsNullOrEmpty(g.Word));
        if (currentGuess != null && !currentGuess.IsEditing)
        {
            var rowIndex = guesses.IndexOf(currentGuess);
            
            if (e.Key == "ArrowLeft" && currentGuess.AvailableSuggestions.Count > 1)
            {
                CycleSuggestion(rowIndex, -1);
            }
            else if (e.Key == "ArrowRight" && currentGuess.AvailableSuggestions.Count > 1)
            {
                CycleSuggestion(rowIndex, 1);
            }
            else if (e.Key == "Enter")
            {
                await LockGuess(rowIndex);
            }
        }
    }

    private async Task<string> GetBugReportUrl()
    {
        try
        {
            // Get browser and OS info via JavaScript
            var browserInfo = await JS.InvokeAsync<string>("getBrowserInfo");
            var osInfo = await JS.InvokeAsync<string>("getOSInfo");
            var consoleErrors = await JS.InvokeAsync<string[]>("getConsoleErrors");
            
            // Build game state summary for additional context
            var lockedGuesses = guesses.Where(g => g.IsLocked).ToList();
            var additionalContext = new System.Text.StringBuilder();
            
            additionalContext.AppendLine($"**Theme:** {(isDarkMode ? "Dark" : "Light")} mode");
            additionalContext.AppendLine();
            
            if (lockedGuesses.Any())
            {
                additionalContext.AppendLine("**Game State:**");
                foreach (var guess in lockedGuesses)
                {
                    var stateStr = string.Join("", guess.States.Select(s => s switch {
                        LetterState.Green => "🟩",
                        LetterState.Yellow => "🟨",
                        _ => "⬜"
                    }));
                    additionalContext.AppendLine($"- {guess.Word} {stateStr}");
                }
                
                var currentWord = guesses.FirstOrDefault(g => !g.IsLocked && !string.IsNullOrEmpty(g.Word))?.Word;
                if (!string.IsNullOrEmpty(currentWord))
                {
                    additionalContext.AppendLine($"- Current word: {currentWord}");
                }
                
                additionalContext.AppendLine($"- Possible words remaining: {possibleWords?.Count ?? 0}");
                additionalContext.AppendLine($"- Solved: {isSolved}");
            }
            
            // Build console errors string
            var consoleErrorsStr = "";
            if (consoleErrors?.Length > 0)
            {
                consoleErrorsStr = string.Join("\n", consoleErrors.Take(10).Select(e => $"- {e}"));
            }
            
            // Build GitHub issue URL with pre-filled fields
            var title = $"[Bug] Issue with Wordle Solver (v{appVersion})";
            var urlBuilder = new System.Text.StringBuilder();
            urlBuilder.Append($"{githubUrl}/issues/new");
            urlBuilder.Append("?template=bug_report.yml");
            urlBuilder.Append($"&title={Uri.EscapeDataString(title)}");
            urlBuilder.Append("&labels=bug");
            urlBuilder.Append($"&version={Uri.EscapeDataString(appVersion)}");
            urlBuilder.Append($"&browser={Uri.EscapeDataString(browserInfo)}");
            urlBuilder.Append($"&os={Uri.EscapeDataString(osInfo)}");
            
            if (!string.IsNullOrEmpty(consoleErrorsStr))
            {
                urlBuilder.Append($"&console={Uri.EscapeDataString(consoleErrorsStr)}");
            }
            
            if (additionalContext.Length > 0)
            {
                urlBuilder.Append($"&additional={Uri.EscapeDataString(additionalContext.ToString())}");
            }
            
            return urlBuilder.ToString();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error building bug report URL: {ex.Message}");
            return $"{githubUrl}/issues/new?template=bug_report.yml&labels=bug";
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var visitsStr = await JS.InvokeAsync<string>("localStorage.getItem", "wordleSolverVisits");
            var solvesStr = await JS.InvokeAsync<string>("localStorage.getItem", "wordleSolverSolves");
            var distributionStr = await JS.InvokeAsync<string>("localStorage.getItem", "wordleSolverDistribution");
            
            if (!string.IsNullOrEmpty(visitsStr) && int.TryParse(visitsStr, out int visits))
            {
                totalVisits = visits;
            }
            
            if (!string.IsNullOrEmpty(solvesStr) && int.TryParse(solvesStr, out int solves))
            {
                totalSolves = solves;
            }
            
            if (!string.IsNullOrEmpty(distributionStr))
            {
                // Format: "1:5,2:10,3:8" (guess number : count)
                var pairs = distributionStr.Split(',', StringSplitOptions.RemoveEmptyEntries);
                foreach (var pair in pairs)
                {
                    var parts = pair.Split(':');
                    if (parts.Length == 2 && int.TryParse(parts[0], out int guess) && int.TryParse(parts[1], out int count))
                    {
                        guessDistribution[guess] = count;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
    }

    private async Task SaveStatistics()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "wordleSolverVisits", totalVisits.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "wordleSolverSolves", totalSolves.ToString());
            
            // Convert distribution to string format
            var distributionStr = string.Join(",", guessDistribution.Select(kvp => $"{kvp.Key}:{kvp.Value}"));
            await JS.InvokeVoidAsync("localStorage.setItem", "wordleSolverDistribution", distributionStr);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving statistics: {ex.Message}");
        }
    }

    private async Task ResetStatistics()
    {
        totalVisits = 1; // Keep current visit
        totalSolves = 0;
        guessDistribution.Clear();
        await SaveStatistics();
        StateHasChanged();
    }

    private void ToggleStats()
    {
        statsExpanded = !statsExpanded;
    }
}
