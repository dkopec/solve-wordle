    private void RemoveGuess(int rowIndex)
    {
        isSolved = false; // Clear solved state
        
        // Clear this guess and all subsequent ones
        for (int i = rowIndex; i < guesses.Count; i++)
        {
            guesses[i].Word = "";
            guesses[i].IsLocked = false;
            guesses[i].IsEditing = false;
            guesses[i].AvailableSuggestions.Clear();
            guesses[i].CurrentSuggestionIndex = 0;
            for (int j = 0; j < 5; j++)
            {
                guesses[i].States[j] = LetterState.Gray;
            }
        }

        // If there's a previous locked guess, re-run the filter to populate this row
        if (rowIndex > 0 && guesses.Take(rowIndex).Any(g => g.IsLocked))
        {
            Task.Run(async () => 
            {
                await FindWordsFromGuesses();
                if (possibleWords != null && possibleWords.Any())
                {
                    var currentGuess = guesses[rowIndex];
                    currentGuess.AvailableSuggestions = possibleWords.Take(10).Select(w => w.Word).ToList();
                    if (currentGuess.AvailableSuggestions.Any())
                    {
                        currentGuess.Word = currentGuess.AvailableSuggestions[0].ToUpper();
                        currentGuess.CurrentSuggestionIndex = 0;
                        
                        // Reset to gray first
                        for (int i = 0; i < 5; i++)
                        {
                            currentGuess.States[i] = LetterState.Gray;
                        }
                        
                        // Inherit green and yellow letters from previous locked guesses
                        foreach (var prevGuess in guesses.Take(rowIndex).Where(g => g.IsLocked))
                        {
                            for (int i = 0; i < 5 && i < prevGuess.Word.Length && i < currentGuess.Word.Length; i++)
                            {
                                var prevLetter = char.ToLower(prevGuess.Word[i]);
                                var currLetter = char.ToLower(currentGuess.Word[i]);
                                
                                if (prevGuess.States[i] == LetterState.Green)
                                {
                                    if (currLetter == prevLetter)
                                    {
                                        currentGuess.States[i] = LetterState.Green;
                                    }
                                }
                                else if (prevGuess.States[i] == LetterState.Yellow)
                                {
                                    if (currLetter == prevLetter)
                                    {
                                        currentGuess.States[i] = LetterState.Yellow;
                                    }
                                }
                            }
                        }
                        
                        // Additional pass for yellow letters in different positions
                        foreach (var prevGuess in guesses.Take(rowIndex).Where(g => g.IsLocked))
                        {
                            for (int prevIdx = 0; prevIdx < 5 && prevIdx < prevGuess.Word.Length; prevIdx++)
                            {
                                if (prevGuess.States[prevIdx] == LetterState.Yellow)
                                {
                                    var yellowLetter = char.ToLower(prevGuess.Word[prevIdx]);
                                    
                                    for (int currIdx = 0; currIdx < 5 && currIdx < currentGuess.Word.Length; currIdx++)
                                    {
                                        var currLetter = char.ToLower(currentGuess.Word[currIdx]);
                                        
                                        if (currLetter == yellowLetter && 
                                            currIdx != prevIdx && 
                                            currentGuess.States[currIdx] != LetterState.Green)
                                        {
                                            currentGuess.States[currIdx] = LetterState.Yellow;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                StateHasChanged();
            });
        }
        else
        {
            // Clear results if no locked guesses remain
            possibleWords = null;
        }
    }

